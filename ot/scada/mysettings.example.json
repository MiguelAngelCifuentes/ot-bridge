{
    "version": 1.4,
    "language": "es",
    "hideEditorOnboarding": false,
    "editorSectionMessages": {
        "hideDevicePluginsNotice": true,
        "hideArMarkersNotice": false
    },
    "uiPort": 1881,
    "logDir": "/usr/src/app/FUXA/server/_logs",
    "logApiLevel": "tiny",
    "dbDir": "/usr/src/app/FUXA/server/_db",
    "daqEnabled": true,
    "daqTokenizer": 24,
    "logs": {
        "retention": "none"
    },
    "broadcastAll": false,
    "lazyViewLoading": false,
    "allowedOrigins": [
        "http://localhost",
        "http://127.0.0.1"
    ],
    "apiRateLimitWindowMs": 300000,
    "apiRateLimitMax": 1000,
    "authRateLimitWindowMs": 300000,
    "authRateLimitMax": 100,
    "heartbeatIntervalSec": 10,
    "webcamSnapShotsDir": "/usr/src/app/FUXA/server/_webcam_snapshots",
    "webcamSnapShotsCleanup": false,
    "webcamSnapShotsRetain": 7,
    "swaggerEnabled": false,
    "nodeRedEnabled": false,
    "nodeRedAuthMode": "secure",
    "nodeRedUnsafeModules": false,
    "workDir": "/usr/src/app/FUXA/server/_appdata",
    "appDir": "/usr/src/app/FUXA/server",
    "packageDir": "/usr/src/app/FUXA/server/_pkg",
    "settingsFile": "/usr/src/app/FUXA/server/_appdata/settings.js",
    "environment": "production",
    "uploadFileDir": "/usr/src/app/FUXA/server/_appdata/_upload_files",
    "imagesFileDir": "/usr/src/app/FUXA/server/_images",
    "widgetsFileDir": "/usr/src/app/FUXA/server/_widgets",
    "reportsDir": "/usr/src/app/FUXA/server/_reports",
    "userSettingsFile": "/usr/src/app/FUXA/server/_appdata/mysettings.json",
    "secureEnabled": true,
    "tokenExpiresIn": "8h",
    "smtp": {
        "host": "",
        "port": 587,
        "mailsender": "",
        "username": ""
    },
    "daqstore": {
        "type": "SQlite",
        "host": "127.0.0.1",
        "tableName": "meters",
        "configurationString": "http::addr=localhost:9000;",
        "retention": "year1"
    },
    "alarms": {
        "retention": "year1"
    },
    "httpUploadFileStatic": "resources",
    "httpStatic": "/usr/src/app/FUXA/client/dist",
    "uiHost": "0.0.0.0",
    "serverPort": 1881
}