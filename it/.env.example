# Copiar a .env y rellenar los valores reales. .env NUNCA se commitea.
# Atajo: `python scripts/ensure_secrets.py` anade a .env las claves que falten con valores aleatorios.
# Despues: scripts/mqtt_passwd.py (usuarios MQTT), influx_users.py, postgres_roles.py (instalacion existente).

# --- Capa OT (PLC) ---
PLC_HOST=openplc-runtime
PLC_PORT=502
PLC_UNIT_ID=1
# Cuenta de administrador del runtime de OpenPLC (API :8443); otb.py la crea en el primer despliegue
OPENPLC_USER=otb-admin
OPENPLC_PASSWORD=CAMBIAR

# --- MQTT (Mosquitto). Cada pareja MQTT_USER_X / MQTT_PASSWORD_X es un usuario del broker ---
MQTT_BROKER=mosquitto
MQTT_PORT=1883
# Interfaz donde se publica 1883 para el SCADA FUXA: 127.0.0.1 en un solo host; IP LAN del host IT con OT/IT separados (firewall: solo desde el host OT)
MQTT_LAN_BIND=127.0.0.1
MQTT_USER_GATEWAY=gateway
MQTT_PASSWORD_GATEWAY=CAMBIAR
MQTT_USER_HISTORIAN=historian
MQTT_PASSWORD_HISTORIAN=CAMBIAR
MQTT_USER_ALARM=alarm-engine
MQTT_PASSWORD_ALARM=CAMBIAR
MQTT_USER_API=plant-api
MQTT_PASSWORD_API=CAMBIAR
MQTT_USER_FUXA=fuxa
MQTT_PASSWORD_FUXA=CAMBIAR
MQTT_USER_OPCUA=opcua
MQTT_PASSWORD_OPCUA=CAMBIAR
MQTT_USER_TWIN=twin
MQTT_PASSWORD_TWIN=CAMBIAR

# --- InfluxDB 1.8 (autenticacion HTTP activa) ---
INFLUX_HOST=influxdb
INFLUX_PORT=8086
INFLUX_DB=plant
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=CAMBIAR
# escritura (historian, digital-twin via historian)
INFLUX_WRITE_USER=historian_w
INFLUX_WRITE_PASSWORD=CAMBIAR
# lectura (Grafana, plant-api, backup)
INFLUX_READ_USER=reader
INFLUX_READ_PASSWORD=CAMBIAR

# --- PostgreSQL / API ---
POSTGRES_DB=plant
POSTGRES_USER=plant
POSTGRES_PASSWORD=CAMBIAR
# rol de solo lectura para el datasource de Grafana
GRAFANA_DB_USER=grafana_ro
GRAFANA_DB_PASSWORD=CAMBIAR

# --- API REST: claves por cliente (cabecera X-API-Key) ---
# GRAFANA y ALARM_ENGINE: solo GET. OPERATOR: todos los metodos (ACK, umbrales).
API_KEY_GRAFANA=CAMBIAR
API_KEY_ALARM_ENGINE=CAMBIAR
API_KEY_OPERATOR=CAMBIAR

# --- Grafana ---
GRAFANA_PASSWORD=CAMBIAR

# --- OPC UA (Basic256Sha256 + usuario) ---
OPC_USER=otbridge
OPC_PASSWORD=CAMBIAR

# --- FUXA (SCADA OT): usuarios del HMI (ot/scada/hmi/security.py los genera si faltan) ---
FUXA_ADMIN_PASSWORD=CAMBIAR
FUXA_OPERADOR_PASSWORD=CAMBIAR
FUXA_SUPERVISOR_PASSWORD=CAMBIAR
FUXA_VISITANTE_PASSWORD=CAMBIAR
