          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT\n  (SELECT count(*) FROM alarms) AS \"Alarmas registradas\",\n  (SELECT count(*) FROM thresholds WHERE enabled) AS \"Umbrales activos\",\n  (SELECT count(*) FROM sensors) AS \"Sensores\",\n  pg_database_size(current_database()) AS \"Tamaño BD\""
        }
      ],
