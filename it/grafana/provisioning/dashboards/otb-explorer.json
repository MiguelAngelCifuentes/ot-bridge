            "uid": "influxdb-plant"
          },
          "refId": "A",
          "query": "SELECT $agg(\"value\") FROM \"sensor_readings\" WHERE (\"variable\" = '$variable' AND \"plc\" =~ /^$plc$/) AND $timeFilter GROUP BY time($interval) fill(none)",
