      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-plant"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "WITH a AS (\n  SELECT variable, ts_active,\n         EXTRACT(EPOCH FROM ts_active - LAG(COALESCE(ts_resolved, ts_active))\n                 OVER (PARTITION BY variable, severity ORDER BY ts_active)) AS gap\n  FROM alarms WHERE severity::text IN (${severity:sqlstring}) AND state::text IN (${state:sqlstring}) AND variable IN (${alarm_var:sqlstring}) AND $__timeFilter(ts_active))\nSELECT variable AS \"Variable\", count(*) AS \"Activaciones\",\n       count(*) FILTER (WHERE gap < 60) AS \"Repetidas < 60 s\",\n       min(gap) AS \"Intervalo mínimo\"\nFROM a GROUP BY variable ORDER BY 3 DESC, 2 DESC"
        }
      ],
