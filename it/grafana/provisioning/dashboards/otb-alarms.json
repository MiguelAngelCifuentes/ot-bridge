    {
      "id": 12,
      "type": "table",
      "title": "Chattering por variable",
      "description": "Activaciones por variable y cuántas se repiten en menos de 60 s (chattering).",
      "gridPos": {
        "x": 16,
        "y": 19,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-plant"
