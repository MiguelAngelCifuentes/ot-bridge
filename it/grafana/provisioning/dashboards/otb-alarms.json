          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT LPAD(h::text, 2, '0') || 'h' AS \"Hora\", COALESCE(c, 0) AS \"Alarmas\"\nFROM generate_series(0, 23) AS h\nLEFT JOIN (SELECT EXTRACT(HOUR FROM ts_active AT TIME ZONE 'Europe/Madrid')::int AS hh, count(*) AS c\n           FROM alarms WHERE severity::text IN (${severity:sqlstring}) AND state::text IN (${state:sqlstring}) AND variable IN (${alarm_var:sqlstring}) AND $__timeFilter(ts_active) GROUP BY 1) x ON x.hh = h\nORDER BY h"
        }
