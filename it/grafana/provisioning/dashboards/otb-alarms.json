                "color": "#8AB8FF",
                "value": null
              },
              {
                "color": "#FF9830",
                "value": 5
              },
              {
                "color": "#F2495C",
                "value": 20
              }
            ]
          },
          "mappings": [],
          "links": [],
          "decimals": 1
        },
        "overrides": []
      },
