      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-plant"
          },
          "refId": "A",
          "query": "SELECT mean(\"level_real\") FROM \"twin_state\" WHERE (\"plc\" =~ /^$plc$/) AND $timeFilter GROUP BY time($__interval) fill(none)",
          "rawQuery": true,
          "resultFormat": "time_series",
